# Static build. Nothing is required to run the site.
# The browser downloads the Python runtime from the pinned Pyodide CDN.

# Used for absolute URLs in metadata and the sitemap.
NEXT_PUBLIC_SITE_URL="https://example.com"

# Set to "true" only if you deploy the server verification route and remove
# `output: "export"` from next.config.ts. Off means submissions are checked by
# the Python runtime running in the reader's browser.
NEXT_PUBLIC_SERVER_VERIFY="false"

{
  "name": "ink-python",
  "version": "0.1.0",
  "private": true,
  "description": "A free, gamified Python course with a real in-browser CPython runtime.",
  "keywords": [
    "python",
    "education",
    "learn-to-code",
    "pyodide",
    "nextjs",
    "typescript",
    "gamification",
    "open-education",
    "interactive-learning",
    "static-site"
  ],
  "author": "Indranil Chatterjee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indranil122/ink-python.git"
  },
  "bugs": {
    "url": "https://github.com/indranil122/ink-python/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "typegen": "next typegen",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:index": "tsx scripts/content/index.ts",
    "content:import": "node scripts/import/exercism.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prebuild": "npm run content:validate && npm run content:index",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typegen && npm run content:validate && npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.3",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "16.3.6",
    "next-mdx-remote": "^6.0.0",
    "pyodide": "^314.0.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
